# Cấu hình phát cho một kênh. Chép thành /etc/chanh-dien/<mã kênh>.env (ví dụ kenh1.env); cai-dat.sh làm sẵn việc này.
# File chứa khóa phát: chỉ root và user chanhdien đọc được (chmod 640). Không chép file này vào thư mục dự án / git.
# Sửa xong RTMP_URL hoặc STREAM_KEY thì lần nối lại kế tiếp tự dùng giá trị mới; muốn áp dụng ngay:
#   sudo systemctl restart chanh-dien-kenh@kenh1

# Lấy ở TikTok LIVE Center / LIVE Producer: "Server URL" và "Stream key" của đúng tài khoản phát kênh này.
RTMP_URL="rtmp://dan_server_url_vao_day"
STREAM_KEY="dan_khoa_phat_vao_day"

# Màn hình ảo. 720x1280 nhẹ hơn nhiều cho CPU; 1080x1920 nét hơn nhưng tốn gần gấp đôi.
# Đổi kích thước phải khởi động lại kênh mới có tác dụng.
WIDTH=720
HEIGHT=1280
FPS=30

# Bitrate. TikTok khuyên 2500–3500 kbps cho 720p; 1080p nên 4000–6000.
VIDEO_KBPS=3000
AUDIO_KBPS=128

# x264 preset: veryfast (mặc định). Máy yếu, CPU luôn > 85%: superfast hoặc ultrafast (nhẹ hơn, hình kém hơn ở cùng bitrate).
X264_PRESET=veryfast

# Số màn hình ảo. Mặc định 100 + số trong tên kênh (kenh1 → 101). Chỉ đặt khi tên kênh không có số.
#DISPLAY_NUM=101
